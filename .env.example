# OTel sample emitter — copy to .env and adjust as needed

# OTLP/HTTP endpoint of the Collector (or any OTLP sink)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Service name reported via resource
OTEL_SERVICE_NAME=otel-sample-emitter

# How long to emit telemetry, in seconds
EMIT_DURATION_SECONDS=60

# Log records emitted per second
LOGS_PER_SECOND=5

# Span trees emitted per second
SPANS_PER_SECOND=2

# Metric collection/export interval in ms
METRIC_INTERVAL_MS=5000

# Logical namespace attached to records as service.namespace
SERVICE_NAMESPACE=demo
